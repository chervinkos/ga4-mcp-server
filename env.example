# =============================================================================
# Google Analytics MCP Server - Environment Configuration
# =============================================================================
#
# Copy this file to '.env' for local runs. On Render, set these as
# Environment Variables in the service dashboard instead - never commit a
# real .env file (it's already excluded via .gitignore).
#
# =============================================================================

# -----------------------------------------------------------------------------
# Google OAuth (required for HTTP transport / Render deployment)
# -----------------------------------------------------------------------------
# From the Google Cloud Console OAuth client (type: "Web application").
# The client's registered redirect URI must be:
#   <SERVER_BASE_URL>/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Public base URL this server is reachable at (no trailing slash, no path).
# Example: https://ga4-mcp-server.onrender.com
SERVER_BASE_URL=

# -----------------------------------------------------------------------------
# Google Analytics 4
# -----------------------------------------------------------------------------
# Default GA4 property ID used when a tool call doesn't specify one.
# Optional, but recommended so Claude doesn't have to guess/ask for it.
GA4_PROPERTY_ID=

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Render sets PORT automatically; only override for local runs if needed.
# PORT=8000
# HOST=0.0.0.0

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# DANGEROUS: set to "true" only to run the HTTP server locally without OAuth
# for quick testing. Never set this on a publicly reachable deployment -
# anyone with the URL could read your Analytics data.
# ALLOW_UNAUTHENTICATED=false
